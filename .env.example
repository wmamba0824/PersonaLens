# PersonaLens: your own chat API key. Never commit .env.
DEEPSEEK_API_KEY=

# Optional configuration
INSTANCE_CONFIG_FILE=instances/general/config.json
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
# 默认直连，只有本机网络必须使用系统代理时才改为 true
DEEPSEEK_USE_SYSTEM_PROXY=false
# Optional Bilibili login/local ASR settings: see .env.tools.example.
# General instance defaults to local vectors (no embedding key).
# RETRIEVAL_BACKEND=lexical  # Optional: skip local model download.
